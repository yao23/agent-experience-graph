{
  "name": "agent-experience-graph",
  "displayName": "Agent Experience Graph",
  "description": "Retrieve verified debugging experience before your coding agent starts from scratch, with local-only feedback and auditable evidence.",
  "version": "0.1.4",
  "publisher": "AgentExperienceGraph",
  "icon": "images/icon.png",
  "license": "MIT-0",
  "homepage": "https://yao23.github.io/agent-experience-graph/docs/install-vscode-extension.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/yao23/agent-experience-graph.git",
    "directory": "integrations/vscode"
  },
  "bugs": {
    "url": "https://github.com/yao23/agent-experience-graph/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Testing",
    "Other"
  ],
  "keywords": [
    "playwright",
    "testing",
    "debugging",
    "agent",
    "skills",
    "experience"
  ],
  "activationEvents": [
    "onView:aeg.playwright",
    "onCommand:aeg.tryVerifiedExperience",
    "onCommand:aeg.openVerifiedExperienceDemo",
    "onCommand:aeg.diagnosePlaywrightFailure",
    "onCommand:aeg.verifyLatestExperience",
    "onCommand:aeg.showExperiences",
    "onCommand:aeg.runPublicRepairLab",
    "onCommand:aeg.discoverSkills",
    "onCommand:aeg.recommendSkill",
    "onCommand:aeg.rateSkill",
    "onCommand:aeg.showSkillMetrics"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aeg.tryVerifiedExperience",
        "title": "AEG: Try a Verified Experience",
        "icon": "$(library)"
      },
      {
        "command": "aeg.openVerifiedExperienceDemo",
        "title": "AEG: Open Verified Experience Challenge",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "aeg.diagnosePlaywrightFailure",
        "title": "AEG: Diagnose Playwright Failure",
        "icon": "$(debug-alt)"
      },
      {
        "command": "aeg.verifyLatestExperience",
        "title": "AEG: Mark Latest Diagnosis Outcome",
        "icon": "$(pass)"
      },
      {
        "command": "aeg.showExperiences",
        "title": "AEG: Show Playwright Experiences",
        "icon": "$(history)"
      },
      {
        "command": "aeg.openGettingStarted",
        "title": "AEG: Playwright Getting Started"
      },
      {
        "command": "aeg.runPublicRepairLab",
        "title": "AEG: Run Public Repair Lab",
        "icon": "$(beaker)"
      },
      {
        "command": "aeg.discoverSkills",
        "title": "AEG: Discover Workspace Skills"
      },
      {
        "command": "aeg.recommendSkill",
        "title": "AEG: Recommend Skill for Current Task"
      },
      {
        "command": "aeg.rateSkill",
        "title": "AEG: Rate a Skill"
      },
      {
        "command": "aeg.showSkillMetrics",
        "title": "AEG: Show Skill Metrics"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aeg.tryVerifiedExperience"
        },
        {
          "command": "aeg.openVerifiedExperienceDemo"
        },
        {
          "command": "aeg.diagnosePlaywrightFailure"
        },
        {
          "command": "aeg.verifyLatestExperience"
        },
        {
          "command": "aeg.showExperiences"
        },
        {
          "command": "aeg.openGettingStarted"
        },
        {
          "command": "aeg.runPublicRepairLab"
        },
        {
          "command": "aeg.discoverSkills"
        },
        {
          "command": "aeg.recommendSkill"
        },
        {
          "command": "aeg.rateSkill"
        },
        {
          "command": "aeg.showSkillMetrics"
        }
      ],
      "editor/context": [
        {
          "command": "aeg.tryVerifiedExperience",
          "when": "editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "aeg.diagnosePlaywrightFailure",
          "when": "editorHasSelection",
          "group": "navigation@2"
        },
        {
          "command": "aeg.recommendSkill",
          "when": "editorHasSelection",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "aeg.tryVerifiedExperience",
          "when": "view == aeg.playwright",
          "group": "navigation@1"
        },
        {
          "command": "aeg.diagnosePlaywrightFailure",
          "when": "view == aeg.playwright",
          "group": "navigation@2"
        },
        {
          "command": "aeg.showExperiences",
          "when": "view == aeg.playwright",
          "group": "navigation@3"
        },
        {
          "command": "aeg.runPublicRepairLab",
          "when": "view == aeg.playwright",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aeg",
          "title": "AEG",
          "icon": "resources/aeg-playwright.svg"
        }
      ]
    },
    "views": {
      "aeg": [
        {
          "id": "aeg.playwright",
          "name": "Verified Experience & Playwright"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aeg.playwright",
        "contents": "Retrieve verified debugging experience before your coding agent starts from scratch.\n[Try a verified experience](command:aeg.tryVerifiedExperience)\n[Open the bundled challenge](command:aeg.openVerifiedExperienceDemo)\n[Diagnose a Playwright failure](command:aeg.diagnosePlaywrightFailure)\n[Run public repair lab](command:aeg.runPublicRepairLab)\n[Open getting started](command:aeg.openGettingStarted)"
      }
    ],
    "configuration": {
      "title": "Agent Experience Graph",
      "properties": {
        "aeg.skillGlobs": {
          "type": "array",
          "default": [
            "**/SKILL.md",
            "**/capability.json"
          ],
          "description": "Workspace globs used to discover agent skills."
        },
        "aeg.telemetryFile": {
          "type": "string",
          "default": ".aeg/skill-metrics.json",
          "description": "Workspace-relative file used for local skill usage metrics."
        },
        "aeg.experienceDirectory": {
          "type": "string",
          "default": ".aeg/experiences",
          "description": "Workspace-relative directory for local Playwright experience receipts."
        },
        "aeg.verifiedExperienceFeedbackFile": {
          "type": "string",
          "default": ".aeg/verified-experience-feedback.json",
          "description": "Workspace-relative file for local usefulness ratings of retrieved verified experiences."
        },
        "aeg.playwrightArtifactGlobs": {
          "type": "array",
          "default": [
            "**/test-results/**/error-context.md",
            "**/test-results/**/*.txt",
            "**/test-results/**/*.log",
            "**/playwright-report/**/*.json",
            "**/junit*.xml"
          ],
          "description": "Workspace globs used to find Playwright failure artifacts."
        },
        "aeg.notifyOnPlaywrightArtifacts": {
          "type": "boolean",
          "default": true,
          "description": "Show a local notification when AEG detects a new Playwright failure artifact."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "sync:repair-lab": "node scripts/sync-repair-lab.js",
    "compile": "npm run sync:repair-lab && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/core.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.5.0"
  }
}
