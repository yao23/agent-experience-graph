{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeg.local/phase1-seed-user/anonymized-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "status", "experiment_classification", "participants", "tasks", "uncontaminated_tasks", "completed_tasks", "objectively_verified_user_value_tasks", "independent_successes", "recommendations_total", "correct_recommendations", "recommendation_correctness_rate", "abstentions_total", "correct_abstentions", "correct_abstention_rate", "material_path_change_count", "misleading_retrieval_count", "participant_usefulness_median", "supported_conclusions", "unsupported_conclusions", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "aeg-verified-experience-seed-user-v1"},
    "status": {"enum": ["not_started", "incomplete", "evaluated"]},
    "experiment_classification": {"enum": ["pending", "initial_positive_signal", "positive_retrieval_signal", "calibration_abstention_evidence_only", "inconclusive", "protocol_failure", "harmful_or_misleading_retrieval", "privacy_or_authorization_failure"]},
    "participants": {"type": "integer", "minimum": 0, "maximum": 5},
    "tasks": {"type": "integer", "minimum": 0, "maximum": 5},
    "uncontaminated_tasks": {"type": "integer", "minimum": 0, "maximum": 5},
    "completed_tasks": {"type": "integer", "minimum": 0, "maximum": 5},
    "objectively_verified_user_value_tasks": {"type": "integer", "minimum": 0, "maximum": 5},
    "independent_successes": {"type": "integer", "minimum": 0, "maximum": 5},
    "recommendations_total": {"type": "integer", "minimum": 0, "maximum": 5},
    "correct_recommendations": {"type": "integer", "minimum": 0, "maximum": 5},
    "recommendation_correctness_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "abstentions_total": {"type": "integer", "minimum": 0, "maximum": 5},
    "correct_abstentions": {"type": "integer", "minimum": 0, "maximum": 5},
    "correct_abstention_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "material_path_change_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "misleading_retrieval_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "participant_usefulness_median": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "supported_conclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unsupported_conclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
