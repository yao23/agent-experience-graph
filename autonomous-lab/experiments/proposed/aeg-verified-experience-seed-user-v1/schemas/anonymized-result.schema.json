{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeg.local/phase1-seed-user/anonymized-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "status", "participants", "tasks", "task_completion_rate", "objective_oracle_pass_rate", "material_path_change_count", "correct_recommendation_rate", "correct_abstention_rate", "misleading_retrieval_count", "participant_usefulness_median", "decision", "supported_conclusions", "unsupported_conclusions", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "aeg-verified-experience-seed-user-v1"},
    "status": {"enum": ["not_started", "incomplete", "evaluated"]},
    "participants": {"type": "integer", "minimum": 0, "maximum": 5},
    "tasks": {"type": "integer", "minimum": 0, "maximum": 5},
    "task_completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "objective_oracle_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "material_path_change_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "correct_recommendation_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "correct_abstention_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "misleading_retrieval_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "participant_usefulness_median": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "decision": {"enum": ["pending", "success", "failure", "inconclusive", "stopped"]},
    "supported_conclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unsupported_conclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
