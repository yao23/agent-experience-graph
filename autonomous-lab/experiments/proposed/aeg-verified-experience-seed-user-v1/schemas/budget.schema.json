{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeg.local/phase1-seed-user/budget.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "participants", "tasks", "model_calls", "commands", "tests", "human_interventions", "wall_clock_hours", "tokens", "model_cost_usd", "participant_payments_usd", "paid_acquisition_usd", "same_failure_repeats", "cost_estimate"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "aeg-verified-experience-seed-user-v1"},
    "participants": {"$ref": "#/$defs/limit"},
    "tasks": {"$ref": "#/$defs/limit"},
    "model_calls": {"$ref": "#/$defs/limit"},
    "commands": {"$ref": "#/$defs/limit"},
    "tests": {"$ref": "#/$defs/limit"},
    "human_interventions": {"$ref": "#/$defs/limit"},
    "wall_clock_hours": {"$ref": "#/$defs/limit"},
    "tokens": {"$ref": "#/$defs/limit"},
    "model_cost_usd": {"$ref": "#/$defs/limit"},
    "participant_payments_usd": {"$ref": "#/$defs/limit"},
    "paid_acquisition_usd": {"$ref": "#/$defs/limit"},
    "same_failure_repeats": {"$ref": "#/$defs/limit"},
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_usd", "basis", "telemetry_rule"],
      "properties": {
        "maximum_usd": {"type": "number", "minimum": 0},
        "basis": {"type": "string", "minLength": 1},
        "telemetry_rule": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "maximum"],
      "properties": {
        "used": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0}
      }
    }
  }
}
