{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeg.local/autonomous-lab/escalation.schema.json",
  "title": "Autonomous Lab Escalation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "escalation_id", "experiment_id", "created_at", "status", "reason_code", "summary", "evidence", "requested_decision", "allowed_resolutions", "tradeoffs", "recommended_choice"],
  "properties": {
    "schema_version": {"const": 1},
    "escalation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["open", "resolved", "declined"]},
    "reason_code": {"enum": ["approval_required", "budget_exhausted", "repeated_failure", "missing_evidence", "contamination", "forbidden_action", "oracle_missing", "external_write"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_decision": {"type": "string", "minLength": 1},
    "allowed_resolutions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tradeoffs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recommended_choice": {"type": "string", "minLength": 1},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "resolution": {"type": ["string", "null"]}
  }
}
