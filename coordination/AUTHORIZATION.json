    "scheduled_max_per_day": 26,
    "shared_daily_max": 30,
    "unknown_cost_rule": "Record actual cost UNKNOWN, reserve that slot/task full cap for admission accounting; unknown never means zero. Duplicate slot invocations do not receive another cap. All four jobs share the daily cap."
  }
