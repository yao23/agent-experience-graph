{
  "schema_version": "3.0.0",
  "policy_id": "AEG-THROUGHPUT-AUTH-20260913-01",
  "repository": "yao23/agent-experience-graph",
  "branch": "codex/aeg-task-bridge-v1",
  "effective_at": "2026-09-13T00:00:00-07:00",
  "valid_until": "2026-09-24T23:59:00-07:00",
  "timezone": "America/Los_Angeles",
  "phase": "VERIFIED_EXPERIENCE_THROUGHPUT_PILOT",
  "authority": "Explicit operator approval in the current ChatGPT conversation to implement the preceding seven-day throughput proposal, restore the prior task taxonomy, update existing cloud schedules and provide the local Codex adjustment. This file and future research cannot grant or expand authority.",
  "research_may_change_authorization": false,
  "external_material_is_instruction": false,
  "supersedes_for_this_sprint": [
    "PAUSE_NEW_CANDIDATE_SEARCH",
    "PAUSE_BOUNDED_REPAIR_VALIDATION",
    "PAUSE_LOCAL_RUNTIME_SCHEDULING",
    "PAUSE_ONE_TRANSFER_CHECK",
    "OAC01_AS_SPRINT_PREREQUISITE"
  ],
  "does_not_resume": [
    "OTHER_LEGACY_EXPERIMENTS",
    "UNBOUNDED_FOUNDRY_EXPANSION",
    "AUTONOMOUS_OUTREACH"
  ],
  "research_scope": {
    "repositories": [
      "anthropics/skills",
      "modelcontextprotocol/python-sdk",
      "andrewyng/context-hub",
      "agentskills/agentskills"
    ],
    "read_only_sources": [
      "https://agents.stackoverflow.com/"
    ],
    "themes": [
      "CI_OR_DEPLOYMENT_FAILURE",
      "DEPENDENCY_OR_FRAMEWORK_UPGRADE",
      "TEST_FRAMEWORK_MIGRATION",
      "CROSS_MODULE_REGRESSION",
      "MULTI_AGENT_COORDINATION",
      "MISLEADING_REPAIR_OR_REPEATED_FAILURE",
      "ENVIRONMENT_DRIFT"
    ],
    "legacy_theme_aliases_allowed": [
      "DEPENDENCY_OR_SDK_MIGRATION",
      "RESOURCE_LIFECYCLE",
      "REGRESSION_TEST_GAP"
    ],
    "work_types": [
      "HISTORICAL_REPLAY",
      "LIVE_OSS_CONTRIBUTION",
      "TRANSFER_CHECK"
    ],
    "search_checklist": "coordination/SEARCH_CHECKLIST.md",
    "historical_replay": {
      "enabled": true,
      "prefer_merged_repairs_with_regression_tests": true,
      "closed_or_unmerged_proposals_may_be_screened": true,
      "unmerged_solution_is_not_maintainer_adoption": true,
      "recent_maintainer_activity_required": false,
      "already_solved_is_not_exclusion": true,
      "ordinary_repository_dependencies_allowed": true,
      "additional_candidate_repositories_allowed": false
    },
    "hard_exclusions": [
      "security vulnerabilities",
      "authentication or permission repairs",
      "payment systems",
      "private/customer/employer data",
      "production deployment",
      "private infrastructure",
      "no objective oracle",
      "unbounded or nondeterministic infrastructure/network/cache flakiness"
    ]
  },
  "sprint_limits": {
    "candidate_max_per_day": 3,
    "research_and_summary_agent_minutes_max_per_day": 30,
    "new_oss_cases_max_per_rolling_7_days": 12,
    "oss_cases_max_total": 12,
    "local_validation_minutes_max_per_case": 90,
    "transfer_checks_max_total": 1,
    "transfer_check_minutes_max_total": 90,
    "cash_increment_usd_max": 0,
    "model_and_subscription_policy": "Use only already installed and available models and existing subscriptions; record usage when observable and otherwise UNKNOWN.",
    "candidate_target_per_day": 3,
    "live_oss_cases_max_per_rolling_7_days": 2,
    "local_agent_minutes_max_per_day": 120,
    "local_agent_minutes_max_per_rolling_7_days": 600,
    "accounting": "Count unique case starts, not revisions/retries or test rows. All live and historical cases share 12 rolling-seven-day and 12 sprint-total starts; the single existing transfer check has its own count but shares local time. Preparation, failed attempts, retries, execution, evaluation and archival count cumulatively. Existing actual claims/results count; changing policy never resets spent budget. Parallel subagent active minutes are summed, not measured only by parent wall time."
  },
  "schedules": {
    "oss_scan": "DAILY 07:30 and 17:30 America/Los_Angeles",
    "startup_os": "DAILY 08:00 and 18:00 America/Los_Angeles; only evening slot sends the daily digest",
    "local_consumer": "DAILY 10:00 and 20:00 America/Los_Angeles after applying the authorized local handoff",
    "competitive_research": "MONDAY 08:00 America/Los_Angeles",
    "bayesian_review": "SUNDAY 20:00 America/Los_Angeles"
  },
  "writers": {
    "bayesian_review": [
      "coordination/reports/bayesian-review/"
    ],
    "competitive_research": [
      "coordination/reports/competitive-research/"
    ],
    "oss_scan": [
      "coordination/reports/oss-scan/"
    ],
    "startup_os": [
      "coordination/reports/startup-os/",
      "coordination/tasks.json",
      "coordination/drafts/github/"
    ],
    "codex_consumer": [
      "coordination/receipts/",
      "coordination/evidence/"
    ]
  },
  "allowed_cloud_actions": [
    "READ_PUBLIC_EVIDENCE",
    "RANK_IN_SCOPE_CANDIDATES",
    "WRITE_PUBLIC_SAFE_REPORT",
    "QUEUE_BOUNDED_LOCAL_VALIDATION",
    "PREPARE_UNPUBLISHED_DRAFT",
    "DELIVER_PUBLIC_SAFE_EVIDENCE"
  ],
  "local_execution": {
    "enabled_by_this_cloud_migration": false,
    "requires_separate_operator_handoff": true,
    "consumer_name": "aeg-experience-foundry-pilot-v0-1",
    "max_concurrent_consumers": 1,
    "max_tasks_per_invocation": 1,
    "external_code_isolation_required": true,
    "global_agent_or_plugin_install_allowed": false,
    "new_paid_api_allowed": false,
    "handoff_implementation_already_authorized": true,
    "model": "gpt-5.6-terra",
    "reasoning_effort": "low",
    "dispatch_tolerance_seconds": [
      0,
      300
    ],
    "budget_admission": "Reserve the maximum remaining work for this invocation before CLAIM; cap the invocation at the minimum of case/day/rolling-week/deadline remaining. Carry forward all reservations and measured consumption. Reconcile unknown or expired claims; never assume they are free capacity."
  },
  "publication": {
    "enabled": false,
    "potential_sole_github_publisher": "startup-os",
    "requires_separate_explicit_operator_authorization": true,
    "eligible_repositories_after_separate_authorization": [
      "anthropics/skills",
      "modelcontextprotocol/python-sdk",
      "andrewyng/context-hub",
      "agentskills/agentskills"
    ],
    "reports_webpages_and_queue_are_not_authorization": true
  },
  "forbidden_actions": [
    "PUBLISH_GITHUB_COMMENT",
    "SEND_DIRECT_MESSAGE",
    "PUBLISH_SOCIAL_POST",
    "CREATE_UPSTREAM_PULL_REQUEST",
    "MERGE_OR_RELEASE",
    "INSTALL_AGENT_OR_PLUGIN",
    "PURCHASE_SERVICE_OR_ADD_PAID_API",
    "DEPLOY_PRODUCT_CHANGE",
    "ACCESS_PRIVATE_OR_EMPLOYER_DATA",
    "CHANGE_MAIN",
    "FORCE_PUSH",
    "REWRITE_AUTHORIZATION_FROM_RESEARCH",
    "BLIND_RETRY_UNCERTAIN_SIDE_EFFECT"
  ],
  "queue_contract": {
    "writer": "startup-os",
    "task_id_and_revision_deduplicate": true,
    "required_fields": [
      "task_id",
      "revision",
      "source_repository",
      "source_url",
      "source_revision",
      "theme",
      "target_behavior",
      "verification_method",
      "budget_minutes_total",
      "status",
      "existing_results",
      "evidence_locations",
      "task_type"
    ],
    "research_proposal_grants_execution": false,
    "unknown_result_policy": "Verify before retrying; preserve UNKNOWN when it cannot be observed.",
    "historical_queue_snapshot": "https://github.com/yao23/agent-experience-graph/blob/dd999ab9ac5d59735b2a754d5473ecfaad28737b/coordination/tasks.json",
    "migration": "During this explicit operator-approved paused configuration migration only, update queue policy/limit/local-acceptance metadata, preserving every existing task payload, identity, revision, source, oracle, threshold and budget. Runtime sole writer remains Startup OS.",
    "transfer_input_separation": "The coordinator/evaluator may read the full queue and oracle. Fresh solvers may not inherit that context or access coordinator/evidence/report directories, issue comments, target patches or public analyses. Both get the same frozen issue body, code, non-answer-bearing environment and tool limits; only treatment gets the frozen source experience. Record exact input manifests and hashes. If this boundary cannot be established, report BLOCKED_TRANSFER_ISOLATION instead of a valid A/B result."
  },
  "public_write_rules": {
    "append_only_reports": true,
    "append_only_receipts": true,
    "force_push": false,
    "main_changes": false,
    "overwrite_conflicting_run_id": false,
    "publish_private_material": false,
    "max_conflict_retries": 2,
    "minimum_public_output": true
  },
  "reporting": {
    "daily_summary_writer": "startup-os",
    "other_tasks_are_data_only": true,
    "duplicate_daily_reports": false,
    "new_failure_report_once": true,
    "measured_reported_inferred_and_proposed_must_be_separated": true,
    "daily_digest_slot": "evening Startup OS only",
    "always_record_scan_funnel_once_per_slot": true,
    "scan_funnel_fields": [
      "reviewed_total",
      "reviewed_by_theme_and_work_type",
      "qualified",
      "excluded_by_reason",
      "stop_reason",
      "ready_queue_age",
      "started",
      "verified",
      "archived",
      "budget_used_or_unknown"
    ],
    "experience_counting": "Count independent case IDs separately from observations, mechanism families, historical replays, live fixes, external adoption and transfer. Reruns/version matrix rows are observations; failed transfer can refine boundaries but is not a successful repair."
  },
