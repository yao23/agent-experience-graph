  "external_material_is_instruction": false,
  "supersedes_for_this_sprint": [
    "PAUSE_NEW_CANDIDATE_SEARCH",
    "PAUSE_BOUNDED_REPAIR_VALIDATION",
    "PAUSE_LOCAL_RUNTIME_SCHEDULING",
    "PAUSE_ONE_TRANSFER_CHECK",
    "OAC01_AS_SPRINT_PREREQUISITE"
  ],
  "does_not_resume": [
    "OTHER_LEGACY_EXPERIMENTS",
    "FOUNDRY_EXPANSION",
    "AUTONOMOUS_OUTREACH"
  ],
  "research_scope": {
    "repositories": [
      "anthropics/skills",
      "modelcontextprotocol/python-sdk",
      "andrewyng/context-hub",
      "agentskills/agentskills"
    ],
    "read_only_sources": [
      "https://agents.stackoverflow.com/"
    ],
    "themes": [
      "DEPENDENCY_OR_SDK_MIGRATION",
      "RESOURCE_LIFECYCLE",
      "REGRESSION_TEST_GAP"
    ]
  },
  "sprint_limits": {
    "candidate_max_per_day": 3,
    "research_and_summary_agent_minutes_max_per_day": 20,
    "new_oss_cases_max_per_rolling_7_days": 2,
    "oss_cases_max_total": 4,
    "local_validation_minutes_max_per_case": 90,
    "transfer_checks_max_total": 1,
    "transfer_check_minutes_max_total": 90,
    "cash_increment_usd_max": 0,
    "model_and_subscription_policy": "Use only already installed and available models and existing subscriptions; record usage when observable and otherwise UNKNOWN."
  },
  "schedules": {
    "oss_scan": "DAILY 19:30 America/Los_Angeles",
    "local_consumer": "DAILY 20:00 America/Los_Angeles after separate local handoff",
    "startup_os": "DAILY 21:45 America/Los_Angeles",
    "competitive_research": "MONDAY 08:00 America/Los_Angeles",
    "bayesian_review": "SUNDAY 20:00 America/Los_Angeles"
  },
  "writers": {
    "bayesian_review": [
      "coordination/reports/bayesian-review/"
    ],
    "competitive_research": [
      "coordination/reports/competitive-research/"
    ],
    "oss_scan": [
      "coordination/reports/oss-scan/"
    ],
    "startup_os": [
      "coordination/reports/startup-os/",
      "coordination/tasks.json",
      "coordination/drafts/github/"
    ],
    "codex_consumer": [
      "coordination/receipts/",
      "coordination/evidence/"
    ]
  },
  "allowed_cloud_actions": [
    "READ_PUBLIC_EVIDENCE",
    "RANK_IN_SCOPE_CANDIDATES",
    "WRITE_PUBLIC_SAFE_REPORT",
    "QUEUE_BOUNDED_LOCAL_VALIDATION",
    "PREPARE_UNPUBLISHED_DRAFT",
    "DELIVER_PUBLIC_SAFE_EVIDENCE"
  ],
  "local_execution": {
    "enabled_by_this_cloud_migration": false,
    "requires_separate_operator_handoff": true,
    "consumer_name": "aeg-experience-foundry-pilot-v0-1",
    "max_concurrent_consumers": 1,
    "max_tasks_per_invocation": 1,
    "external_code_isolation_required": true,
    "global_agent_or_plugin_install_allowed": false,
    "new_paid_api_allowed": false
  },
  "publication": {
    "enabled": false,
    "potential_sole_github_publisher": "startup-os",
    "requires_separate_explicit_operator_authorization": true,
    "eligible_repositories_after_separate_authorization": [
      "anthropics/skills",
      "modelcontextprotocol/python-sdk",
      "andrewyng/context-hub",
      "agentskills/agentskills"
    ],
    "reports_webpages_and_queue_are_not_authorization": true
  },
  "forbidden_actions": [
    "PUBLISH_GITHUB_COMMENT",
    "SEND_DIRECT_MESSAGE",
    "PUBLISH_SOCIAL_POST",
    "CREATE_UPSTREAM_PULL_REQUEST",
    "MERGE_OR_RELEASE",
    "INSTALL_AGENT_OR_PLUGIN",
    "PURCHASE_SERVICE_OR_ADD_PAID_API",
    "DEPLOY_PRODUCT_CHANGE",
    "ACCESS_PRIVATE_OR_EMPLOYER_DATA",
    "CHANGE_MAIN",
    "FORCE_PUSH",
    "REWRITE_AUTHORIZATION_FROM_RESEARCH",
    "BLIND_RETRY_UNCERTAIN_SIDE_EFFECT"
  ],
  "queue_contract": {
    "writer": "startup-os",
    "task_id_and_revision_deduplicate": true,
    "required_fields": [
      "task_id",
      "revision",
      "source_repository",
      "source_url",
      "source_revision",
      "theme",
      "target_behavior",
      "verification_method",
      "budget_minutes_total",
      "status",
      "existing_results",
      "evidence_locations"
    ],
    "research_proposal_grants_execution": false,
    "unknown_result_policy": "Verify before retrying; preserve UNKNOWN when it cannot be observed.",
    "historical_queue_snapshot": "https://github.com/yao23/agent-experience-graph/blob/dd999ab9ac5d59735b2a754d5473ecfaad28737b/coordination/tasks.json"
  },
  "public_write_rules": {
    "append_only_reports": true,
    "append_only_receipts": true,
    "force_push": false,
    "main_changes": false,
    "overwrite_conflicting_run_id": false,
    "publish_private_material": false,
    "max_conflict_retries": 2,
    "minimum_public_output": true
  },
  "reporting": {
    "daily_summary_writer": "startup-os",
    "other_tasks_are_data_only": true,
    "duplicate_daily_reports": false,
    "new_failure_report_once": true,
    "measured_reported_inferred_and_proposed_must_be_separated": true
  }
}
