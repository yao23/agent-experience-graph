+@pytest.mark.asyncio
+async def test_custom_header_http_client_closed_after_normal_exit(
+    captured_production_http_client,
+):
+    """A caller-owned SDK client created by MCPConnectionHTTP is closed."""
+    connection = MCPConnectionHTTP(
+        url="https://example.invalid/mcp",
+        headers={"X-Replay-Test": "sentinel"},
+    )
+
+    async with connection:
+        client = captured_production_http_client["client"]
+        assert client is not None
+        assert client.headers["X-Replay-Test"] == "sentinel"
+        assert client.is_closed is False
+
+    assert client.is_closed is True
+
+
+@pytest.mark.asyncio
+async def test_custom_header_http_client_closed_after_initialize_error(
+    captured_production_http_client,
+):
+    """The same client is closed when ClientSession.initialize fails."""
+    expected_error = ExpectedInitializationError("expected initialize failure")
+    StubClientSession.initialize_error = expected_error
+    connection = MCPConnectionHTTP(
+        url="https://example.invalid/mcp",
+        headers={"X-Replay-Test": "sentinel"},
+    )
+
+    with pytest.raises(ExpectedInitializationError, match="expected initialize failure"):
+        async with connection:
+            pytest.fail("connection unexpectedly entered after initialize failure")
+
+    client = captured_production_http_client["client"]
+    assert client is not None
+    assert client.headers["X-Replay-Test"] == "sentinel"
+    assert client.is_closed is True
+
