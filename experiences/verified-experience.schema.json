{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yao23/agent-experience-graph/experiences/verified-experience.schema.json",
  "title": "AEG verified experience library",
  "type": "array",
  "minItems": 1,
  "items": {"$ref": "#/definitions/experience"},
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"$ref": "#/definitions/nonEmptyString"}},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmptyString"}},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "safeUrl": {"type": "string", "pattern": "^https://"},
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nullableCommitSha": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/commitSha"}]},
    "outcome": {"enum": ["success", "partial", "failure"]},
    "verificationStatus": {
      "enum": [
        "LOCALLY_VERIFIED",
        "CROSS_RUN_VERIFIED",
        "CROSS_MODEL_TRANSFERRED",
        "EXTERNALLY_REPRODUCED",
        "STALE_OR_FAILED_REPLAY"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symptoms", "error_signatures"],
      "properties": {
        "symptoms": {"$ref": "#/definitions/nonEmptyStringArray"},
        "error_signatures": {"$ref": "#/definitions/stringArray"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_when", "exclusions"],
      "properties": {
        "applies_when": {"$ref": "#/definitions/nonEmptyStringArray"},
        "exclusions": {"$ref": "#/definitions/nonEmptyStringArray"}
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit_sha"],
      "properties": {
        "version": {"$ref": "#/definitions/nonEmptyString"},
        "commit_sha": {"$ref": "#/definitions/commitSha"}
      }
    },
    "environmentFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "runtime", "operating_system", "dependencies"],
      "properties": {
        "language": {"$ref": "#/definitions/nonEmptyString"},
        "runtime": {"$ref": "#/definitions/nonEmptyString"},
        "operating_system": {"$ref": "#/definitions/nonEmptyString"},
        "dependencies": {"$ref": "#/definitions/nonEmptyStringArray"}
      }
    },
    "agentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model", "harness", "reasoning"],
      "properties": {
        "agent": {"$ref": "#/definitions/nonEmptyString"},
        "model": {"$ref": "#/definitions/nonEmptyString"},
        "harness": {"$ref": "#/definitions/nonEmptyString"},
        "reasoning": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_revision", "environment_fingerprint", "agent_context"],
      "properties": {
        "repository": {"$ref": "#/definitions/safeUrl"},
        "source_revision": {"$ref": "#/definitions/sourceRevision"},
        "environment_fingerprint": {"$ref": "#/definitions/environmentFingerprint"},
        "agent_context": {"$ref": "#/definitions/agentContext"}
      }
    },
    "failedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach", "observed_result", "why_failed"],
      "properties": {
        "approach": {"$ref": "#/definitions/nonEmptyString"},
        "observed_result": {"$ref": "#/definitions/nonEmptyString"},
        "why_failed": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "verificationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "checks", "evidence_refs"],
      "properties": {
        "summary": {"$ref": "#/definitions/nonEmptyString"},
        "checks": {"$ref": "#/definitions/nonEmptyStringArray"},
        "evidence_refs": {"$ref": "#/definitions/nonEmptyStringArray"}
      }
    },
    "registryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "status", "note"],
      "properties": {
        "value": {"anyOf": [{"type": "null"}, {"type": "number"}]},
        "unit": {"$ref": "#/definitions/nonEmptyString"},
        "status": {"enum": ["measured", "unknown"]},
        "note": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "registryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "commands", "retries", "wall_time"],
      "properties": {
        "tokens": {"$ref": "#/definitions/registryMetric"},
        "commands": {"$ref": "#/definitions/registryMetric"},
        "retries": {"$ref": "#/definitions/registryMetric"},
        "wall_time": {"$ref": "#/definitions/registryMetric"}
      }
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "outcome"],
      "properties": {
        "description": {"$ref": "#/definitions/nonEmptyString"},
        "skills": {"$ref": "#/definitions/stringArray"},
        "tools": {"$ref": "#/definitions/stringArray"},
        "outcome": {"$ref": "#/definitions/outcome"},
        "lessons": {"$ref": "#/definitions/stringArray"}
      }
    },
    "publicSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "buggyCommitSha", "fixedCommitSha", "license", "benchmark"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://"},
        "buggyCommitSha": {"$ref": "#/definitions/commitSha"},
        "fixedCommitSha": {"$ref": "#/definitions/commitSha"},
        "license": {"$ref": "#/definitions/nonEmptyString"},
        "benchmark": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "experimentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sourceReportCreatedAt", "runnerSourceCommitSha", "runnerSourceCommitStatus"],
      "properties": {
        "artifact": {"$ref": "#/definitions/nonEmptyString"},
        "sourceReportCreatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
        "runnerSourceCommitSha": {"$ref": "#/definitions/nullableCommitSha"},
        "runnerSourceCommitStatus": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "promotionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowName", "workflowFile", "validatedCommitSha", "status", "runResolver"],
      "properties": {
        "workflowName": {"$ref": "#/definitions/nonEmptyString"},
        "workflowFile": {"$ref": "#/definitions/nonEmptyString"},
        "validatedCommitSha": {"$ref": "#/definitions/nullableCommitSha"},
        "status": {"enum": ["expected-on-pull-request", "observed-passed", "observed-failed"]},
        "runResolver": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceVersion", "recordedAt", "publicSource", "experimentEvidence", "promotionEvidence", "publication"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://"},
        "sourceVersion": {"$ref": "#/definitions/nonEmptyString"},
        "recordedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
        "publicSource": {"$ref": "#/definitions/publicSource"},
        "experimentEvidence": {"$ref": "#/definitions/experimentEvidence"},
        "promotionEvidence": {"$ref": "#/definitions/promotionEvidence"},
        "publication": {
          "type": "object", "additionalProperties": false, "required": ["pullRequest"],
          "properties": {"pullRequest": {"type": "string", "pattern": "^https://"}}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "localChecks"],
      "properties": {
        "status": {"enum": ["passed", "failed", "partial"]},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["experimentArtifact", "experienceSchema", "semanticValidator"],
          "properties": {
            "experimentArtifact": {"$ref": "#/definitions/nonEmptyString"},
            "experienceSchema": {"$ref": "#/definitions/nonEmptyString"},
            "semanticValidator": {"$ref": "#/definitions/nonEmptyString"},
            "pairedResultsValidator": {"$ref": "#/definitions/nonEmptyString"},
            "resultValidator": {"$ref": "#/definitions/nonEmptyString"}
          }
        },
        "localChecks": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"anyOf": [{"type": "string"}, {"$ref": "#/definitions/stringArray"}]}
        }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedCommands", "actualTestExecutions", "nonCachedTokens", "durationMs"],
      "properties": {
        "completedCommands": {"type": "number"},
        "actualTestExecutions": {"type": "number"},
        "nonCachedTokens": {"type": "number"},
        "durationMs": {"type": "number"}
      }
    },
    "pairedMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairedTrials", "baselineArms", "assistedArms", "baselineArmsVerified", "assistedArmsVerified", "pairedMedianAssistedMinusBaseline", "interpretation"],
      "properties": {
        "pairedTrials": {"type": "integer", "minimum": 1},
        "baselineArms": {"type": "integer", "minimum": 1},
        "assistedArms": {"type": "integer", "minimum": 1},
        "baselineArmsVerified": {"type": "integer", "minimum": 0},
        "assistedArmsVerified": {"type": "integer", "minimum": 0},
        "pairedMedianAssistedMinusBaseline": {"$ref": "#/definitions/deltas"},
        "interpretation": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "nullableNonnegativeInteger": {
      "anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
    },
    "collectionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "completedCommands", "actualTestExecutions", "durationMs", "nonCachedTokens", "interpretation"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0, "maximum": 3},
        "completedCommands": {"type": "integer", "minimum": 0},
        "actualTestExecutions": {"type": "integer", "minimum": 0},
        "durationMs": {"$ref": "#/definitions/nullableNonnegativeInteger"},
        "nonCachedTokens": {"$ref": "#/definitions/nullableNonnegativeInteger"},
        "interpretation": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "metrics": {
      "oneOf": [
        {"$ref": "#/definitions/pairedMetrics"},
        {"$ref": "#/definitions/collectionMetrics"}
      ]
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievalTags", "recommendedFor"],
      "properties": {
        "retrievalTags": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmptyString"}},
        "recommendedFor": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmptyString"}}
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "slug", "title", "summary", "category", "verification_status", "problem", "applicability", "context", "failed_attempts", "recovery_steps", "verification_method", "registry_metrics", "last_verified_at", "agent_ready_instructions", "license", "task", "outcome", "subtasks", "skills", "tools", "constraints", "lessons", "provenance", "verification", "metrics", "limitations", "reuse"],
      "properties": {
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "id": {"type": "string", "pattern": "^trace-[a-z0-9][a-z0-9.-]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"$ref": "#/definitions/nonEmptyString"},
        "summary": {"$ref": "#/definitions/nonEmptyString"},
        "category": {"$ref": "#/definitions/nonEmptyString"},
        "verification_status": {"$ref": "#/definitions/verificationStatus"},
        "problem": {"$ref": "#/definitions/problem"},
        "applicability": {"$ref": "#/definitions/applicability"},
        "context": {"$ref": "#/definitions/context"},
        "failed_attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/failedAttempt"}},
        "recovery_steps": {"$ref": "#/definitions/nonEmptyStringArray"},
        "verification_method": {"$ref": "#/definitions/verificationMethod"},
        "registry_metrics": {"$ref": "#/definitions/registryMetrics"},
        "last_verified_at": {"$ref": "#/definitions/timestamp"},
        "agent_ready_instructions": {"$ref": "#/definitions/nonEmptyString"},
        "license": {"$ref": "#/definitions/nonEmptyString"},
        "task": {"$ref": "#/definitions/nonEmptyString"},
        "outcome": {"$ref": "#/definitions/outcome"},
        "subtasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/subtask"}},
        "skills": {"$ref": "#/definitions/stringArray"},
        "tools": {"$ref": "#/definitions/stringArray"},
        "constraints": {"$ref": "#/definitions/stringArray"},
        "lessons": {"$ref": "#/definitions/stringArray"},
        "provenance": {"$ref": "#/definitions/provenance"},
        "verification": {"$ref": "#/definitions/verification"},
        "metrics": {"$ref": "#/definitions/metrics"},
        "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmptyString"}},
        "reuse": {"$ref": "#/definitions/reuse"}
      }
    }
  }
}
